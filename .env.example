# Copy to .env on the VPS and fill in. Never commit .env.

# Public hostname pointing to the VPS (e.g. srv123456.hstgr.cloud or your own domain).
DOMAIN=srvXXXXXX.hstgr.cloud

# Postgres credentials (the container creates this user on first start).
DB_USERNAME=masgym
DB_PASSWORD=change-me

# At least 32 characters. Reuse the one from Render so existing sessions stay valid.
JWT_SECRET=

MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_EMAIL=

# Only used when no ADMIN user exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
